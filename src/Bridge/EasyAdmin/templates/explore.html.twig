{% extends '@EasyAdmin/page/content.html.twig' %}
{% trans_default_domain 'JoliMediaEasyAdminBundle' %}

{% form_theme create_media_form '@JoliMediaEasyAdmin/form/upload_form_theme.html.twig' %}

{% block page_title %}{{ 'media_library'|trans }}{% endblock %}

{% block content_top_header %}
    {% set has_search = true %}
    {{ parent() }}
{% endblock %}

{% block search %}
    <div class="d-md-flex align-items-center w-100">
        {% if breadcrumb|length >= 1 %}
            <ul class="breadcrumb m-0 p-0 bg-transparent flex-shrink-0">
                {% for element in breadcrumb %}
                    <li class="breadcrumb-item breadcrumb-item--ellipsis{{ loop.last ? ' active' : '' }}">
                        {% if loop.last %}
                            {{ element.name }}
                        {% else %}
                            <a href="{{ element.url }}">{{ element.name }}</a>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        <form method="get" class="joli-media-search-form ms-md-3" data-component="media-search">
            {% if not joli_media_admin_uses_pretty_urls() %}
                {# without pretty URLs, the media library is reached through the dashboard route #}
                <input type="hidden" name="routeName" value="{{ joli_media_admin_route(action) }}">
                <input type="hidden" name="routeParams[key]" value="{{ current_key }}">
            {% endif %}
            <div class="form-group">
                <div class="form-widget">
                    <twig:ea:Icon name="internal:search" class="content-search-icon" />

                    <label class="content-search-label" data-value="{{ search }}">
                        <input class="form-control {{ search ? '' : 'is-blank' }}" type="search" name="query" value="{{ search }}" placeholder="{{ 'action.search'|trans({ }, 'EasyAdminBundle') }}" spellcheck="false" autocorrect="off" oninput="this.parentNode.dataset.value=this.value">
                    </label>

                    {% if search %}
                        <a href="{{ joli_media_admin_url(action, '.' != current_key ? { key: current_key } : { }) }}" class="content-search-reset">
                            <twig:ea:Icon name="internal:xmark" />
                        </a>
                    {% endif %}
                </div>
            </div>
        </form>
    </div>
{% endblock %}

{% block body_breadcrumb %}{% endblock %}
{% block body_content_header_wrapper %}{% endblock %}

{% block body_class %}ea-content-width-full{% endblock %}

{% block add_media_button %}
    <twig:ea:Button
        htmlElement="a"
        variant="primary"
        icon="fas fa-plus-circle"
        data-component="media-add"
        tabindex="0"
    >{{ 'media.add'|trans(domain: 'JoliMediaEasyAdminBundle') }}</twig:ea:Button>
{% endblock %}

{% block choose_directory_button %}{% endblock %}

{% block delete_directory_button %}
    {% if breadcrumb|length > 1 and joli_media_admin_is_granted('DELETE_DIRECTORY', path: current_key) %}
        <twig:ea:Button
            htmlElement="a"
            variant="danger"
            icon="fa fa-fw fa-trash-o"
            href="{{ joli_media_admin_url('deleteDirectory') }}"
            class="action-delete-directory me-sm-3"
            data-action-name="delete"
            data-bs-toggle="modal"
            data-bs-target="#modal-delete-directory"
        >{{ 'action.delete_directory'|trans(domain: 'JoliMediaEasyAdminBundle') }}</twig:ea:Button>

        {{ form_start(delete_directory_form, { attr: { id: 'delete-directory-form' } }) }}
            {{ form_widget(delete_directory_form) }}
        {{ form_end(delete_directory_form) }}

        <div id="modal-delete-directory" class="modal fade" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-body">
                        <h4>{{ 'directory.delete_modal.title'|trans }}</h4>
                        <p>{{ 'directory.delete_modal.content'|trans }}</p>
                    </div>
                    <div class="modal-footer">
                        <twig:ea:Button type="button" data-bs-dismiss="modal">
                            {{ 'action.cancel'|trans(domain: 'EasyAdminBundle') }}
                        </twig:ea:Button>

                        <twig:ea:Button type="submit" variant="danger" data-bs-dismiss="modal" id="modal-delete-directory-button" form="delete-directory-form">
                            {{ 'action.delete_directory'|trans(domain: 'JoliMediaEasyAdminBundle') }}
                        </twig:ea:Button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block rename_directory_button %}
    {% if breadcrumb|length > 1 and joli_media_admin_is_granted('RENAME_DIRECTORY', path: current_key) %}
        <twig:ea:Button
            htmlElement="a"
            icon="fa fa-pen-to-square"
            data-component="folder-rename"
            tabindex="0"
        >{{ 'action.rename_directory'|trans(domain: 'JoliMediaEasyAdminBundle') }}</twig:ea:Button>
    {% endif %}
{% endblock %}

{% block rename_directory_container %}
    <div class="rename-directory-container">
        {{ form_start(rename_directory_form, { action: joli_media_admin_url('renameDirectory') }) }}
            {{ form_widget(rename_directory_form.to) }}
            {{ form_widget(rename_directory_form.from) }}
            {{ form_widget(rename_directory_form.submit) }}
        {{ form_end(rename_directory_form) }}
    </div>
{% endblock %}

{% block media_grid_view %}
    <li class="gallery-grid-item">
        <a class="gallery-grid-item__link" href="{{ joli_media_admin_url('show', { key: media.path }) }}">
            <span class="media-preview">
                {{ include('@JoliMediaEasyAdmin/_as_image.html.twig') }}
            </span>
            <span class="gallery-grid-item__name">{{ media.filename }}</span>
        </a>
    </li>
{% endblock %}

{% block media_list_view %}
    <tr>
        <td data-column="name" data-label="name" class="text-left" dir="ltr">
            <a href="{{ joli_media_admin_url('show', { key: media.path }) }}" class="gallery-list-item">
                <span class="gallery-list-item__preview">
                    {{ include('@JoliMediaEasyAdmin/_as_image.html.twig', { variation: 'joli_media_easy_admin_small' }) }}
                </span>
                <span class="gallery-list-item__name">{{ media.filename }}</span>
            </a>
        </td>
        <td data-column="type" data-label="name" class="text-left" dir="ltr">
            <span class="badge badge-secondary">{{ 'media.type.%s'|format(media.fileType)|trans }}</span>
        </td>
        <td data-column="file-size" data-label="name" class="text-left" dir="ltr">
            {{ media.fileSize|joli_media_admin_readable_filesize }}
        </td>
        <td data-column="dimensions" data-label="name" class="text-left" dir="ltr">
            {% set pixelDimensions = media.pixelDimensions %}
            {% if pixelDimensions.width is defined %}
                {{ pixelDimensions.width }}x{{ pixelDimensions.height }}
            {% else %}
                &nbsp;
            {% endif %}
        </td>
    </tr>
{% endblock %}
