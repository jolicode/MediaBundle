{% extends base_template %}
{% trans_default_domain 'JoliMediaEasyAdminBundle' %}

{% block page_title %}{{ 'media_explorer'|trans }} - {{ current_key ? current_key : 'root'|trans }}{% endblock %}

{% block body_class %}ea-content-width-full joli-media-explore{% endblock %}

{% block main %}
    {{ block('body_breadcrumb') }}
    {{ block('body_content_header_wrapper') }}

    <div class="gallery">
        {% if app.session.get('view_mode') == 'list' %}
            <table class="table datagrid gallery-list {{ (directories|length + medias|length) == 0 ? 'datagrid-empty' }}">
                <thead>
                    <tr>
                        <th data-column="name" class="text-left" dir="ltr">
                            <span>{{ 'media.name'|trans }}</span>
                        </th>
                        <th data-column="type" class="text-left" dir="ltr">
                            <span>{{ 'media.type.label'|trans }}</span>
                        </th>
                        <th data-column="file-size" class="text-left" dir="ltr">
                            <span>{{ 'media.size.label_long'|trans }}</span>
                        </th>
                        <th data-column="dimensions" class="text-left" dir="ltr">
                            <span>{{ 'media.dimensions'|trans }}</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {% if parent_key != '' and current_key != '.' -%}
                        <tr>
                            <td data-column="name" data-label="name" class="text-left" dir="ltr">
                                <a href="{{ joli_media_admin_url(action, '.' != parent_key ? { key: parent_key } : { }) }}" class="gallery-list-item gallery-list-item--back">
                                    <span class="gallery-list-item__icon"><i class="fas fa-arrow-left"></i></span>
                                    {{ 'back'|trans }}
                                </a>
                            </td>
                            <td data-column="type" data-label="name" class="text-left" dir="ltr">
                                <span class="badge badge-info">{{ 'directory.label'|trans }}</span>
                            </td>
                            <td data-column="file-size" data-label="name" class="text-left" dir="ltr">
                                &nbsp;
                            </td>
                            <td data-column="dimensions" data-label="name" class="text-left" dir="ltr">
                                &nbsp;
                            </td>
                        </tr>
                    {% endif %}
                    {% for directory in directories %}
                        {% if joli_media_admin_is_granted('LIST', path: directory) %}
                            <tr>
                                <td data-column="name" data-label="name" class="text-left" dir="ltr">
                                    <a href="{{ joli_media_admin_url(action, { key: directory }) }}" class="gallery-list-item">
                                        <span class="gallery-list-item__icon"><i class="fa fa-folder"></i></span>
                                        <span class="gallery-list-item__name">{{ directory|joli_media_admin_basename }}</span>
                                    </a>
                                </td>
                                <td data-column="type" data-label="name" class="text-left" dir="ltr">
                                    <span class="badge badge-info">{{ 'directory.label'|trans }}</span>
                                </td>
                                <td data-column="file-size" data-label="name" class="text-left" dir="ltr">
                                    &nbsp;
                                </td>
                                <td data-column="dimensions" data-label="name" class="text-left" dir="ltr">
                                    &nbsp;
                                </td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                    {% for media in medias %}
                        {% if joli_media_admin_is_granted('SHOW', path: media.path) %}
                            {{ block('media_list_view') }}
                        {% endif %}
                    {% endfor %}
                    {% if directories|length + medias|length == 0 %}
                        <tr>
                            <td colspan="4" class="text-center">
                                <div class="alert alert-info">
                                    <i class="fa fa-info"></i> <strong>{{ 'no_file_found'|trans }}</strong>
                                </div>
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        {% else %}
            <ul class="gallery-grid gallery-grid--folders">
                {% if parent_key != '' and current_key != '.' -%}
                    <li class="gallery-grid-item gallery-grid-item--back">
                        <a href="{{ joli_media_admin_url(action, '.' != parent_key ? { key: parent_key } : { }) }}" class="gallery-grid-item__link">
                            <span class="gallery-grid-item__icon"><i class="fas fa-arrow-left"></i></span>
                            <span class="gallery-grid-item__name">{{ 'back'|trans }}</span>
                        </a>
                    </li>
                {%- endif -%}

                {%- for directory in directories -%}
                    {% if joli_media_admin_is_granted('LIST', path: directory) %}
                        <li class="gallery-grid-item">
                            <a href="{{ joli_media_admin_url(action, { key: directory }) }}" class="gallery-grid-item__link">
                                <span class="gallery-grid-item__icon"><i class="fas fa-folder"></i></span>
                                <span class="gallery-grid-item__name">{{ directory|joli_media_admin_basename }}</span>
                            </a>
                        </li>
                    {% endif %}
                {%- endfor -%}
            </ul>

            <ul class="gallery-grid gallery-grid--files">
                {% for media in medias -%}
                    {% if joli_media_admin_is_granted('SHOW', path: media.path) %}
                        {{ block('media_grid_view') }}
                    {% endif %}
                {%- endfor %}
            </ul>
        {% endif %}

        {% if paginator is defined and paginator.hasToPaginate %}
            {{ include('@EasyAdmin/crud/paginator.html.twig') }}
        {% endif %}
    </div>
{% endblock %}

{% block content_header_wrapper %}
    <div class="joli-media-header-tools" data-component="media-tools">
        <section class="content-header">
            {% block content_header %}
                <div class="content-header-title">
                    {% set current_view_mode = app.session.get('view_mode', 'grid') %}
                    <div class="joli-media-view-switch" role="group" aria-label="{{ 'view.label'|trans }}">
                        <twig:ea:Button
                            htmlElement="a"
                            size="sm"
                            icon="fas fa-list"
                            href="{{ joli_media_admin_url(action, { key: current_key }, { view_mode: 'list' }) }}"
                            class="{{ 'list' == current_view_mode ? 'active disabled' }}"
                            aria-current="{{ 'list' == current_view_mode ? 'true' : 'false' }}"
                        >{{ 'view.list'|trans(domain: 'JoliMediaEasyAdminBundle') }}</twig:ea:Button>
                        <twig:ea:Button
                            htmlElement="a"
                            size="sm"
                            icon="fas fa-th-large"
                            href="{{ joli_media_admin_url(action, { key: current_key }, { view_mode: 'grid' }) }}"
                            class="{{ 'grid' == current_view_mode ? 'active disabled' }}"
                            aria-current="{{ 'grid' == current_view_mode ? 'true' : 'false' }}"
                        >{{ 'view.grid'|trans(domain: 'JoliMediaEasyAdminBundle') }}</twig:ea:Button>
                    </div>
                </div>

                {% block page_actions_wrapper %}
                    <div class="page-actions">
                        {% block page_actions %}
                            {{ block('delete_directory_button') }}
                            {{ block('rename_directory_button') }}
                            {% block create_directory_button %}
                                {% if joli_media_admin_is_granted('CREATE_DIRECTORY', path: current_key) %}
                                    <twig:ea:Button
                                        htmlElement="a"
                                        icon="fa-solid fa-folder-plus"
                                        class="me-sm-2"
                                        data-component="folder-create"
                                        tabindex="0"
                                    >{{ 'directory.create'|trans(domain: 'JoliMediaEasyAdminBundle') }}</twig:ea:Button>
                                {% endif %}
                            {% endblock %}
                            {% block search_button %}
                                {% if base_template ends with '/choose.html.twig' %}
                                    <twig:ea:Button
                                        htmlElement="a"
                                        icon="fa-solid fa-magnifying-glass"
                                        class="me-sm-2"
                                        data-component="search"
                                        tabindex="0"
                                    >{{ 'action.search'|trans(domain: 'JoliMediaEasyAdminBundle') }}</twig:ea:Button>
                                {% endif %}
                            {% endblock %}
                            {{ block('choose_directory_button') }}
                            {% if joli_media_admin_is_granted('UPLOAD', path: current_key) %}
                                {{ block('add_media_button') }}
                            {% endif %}
                        {% endblock %}
                    </div>
                {% endblock %}
            {% endblock content_header %}
        </section>
        <div class="uploader-container" data-component="uploader-container">
            {{ form_start(create_media_form, { attr: {
                class: 'uploader',
                'data-component': 'uploader',
                'data-uploader-config': config.uploadOptions|json_encode(constant('JSON_THROW_ON_ERROR')),
            } }) }}
                {{ form_widget(create_media_form.path) }}
                {{ form_widget(create_media_form._token) }}
                <div class="uploader-preview-template" data-component="uploader-preview-template">
                    {{ include('@JoliMediaEasyAdmin/uploaded_file_preview.html.twig') }}
                </div>
            </form>
        </div>
        <div class="new-directory-container" data-component="new-directory-container">
            {{ form_start(create_directory_form, { action: joli_media_admin_url('createDirectory') }) }}
                {{ form_widget(create_directory_form.directory) }}
                {{ form_widget(create_directory_form.submit) }}
            {{ form_end(create_directory_form) }}
        </div>
        {% if base_template ends with '/choose.html.twig' %}
            <div class="search-container" data-component="search-container">
                <form data-component="media-search" method="get" action="{{ joli_media_admin_url(action, '.' != current_key ? { key: current_key } : { }) }}">
                    <input type="search" name="query" class="form-control" data-component="media-search-input" placeholder="{{ 'media.search_label'|trans }}" value="{{ search }}" autocomplete="off">
                    <twig:ea:Button type="submit" variant="primary" class="joli-media-search-btn">{{ 'action.search'|trans(domain: 'JoliMediaEasyAdminBundle') }}</twig:ea:Button>
                </form>
            </div>
        {% endif %}
        {{ block('rename_directory_container') }}
    </div>
{% endblock %}
