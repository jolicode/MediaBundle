<div class="uploader-preview" data-thumbnail="none">
  <div class="uploader-preview-image media-preview"><a data-upload-link><img data-upload-thumbnail /></a></div>
  <div class="uploader-preview-details">
    <div class="uploader-preview-name gallery-grid-item__name">
      <span class="uploader-success-marker">
        {{ ux_icon('tabler:circle-check') }}
      </span>
      <span class="uploader-error-marker">
        {{ ux_icon('tabler:alert-circle') }}
      </span>
      <span data-upload-name></span>
    </div>
  </div>
  <div class="uploader-progress">
    <span class="uploader-progress-bar" data-upload-progress></span>
  </div>
  <div class="uploader-error-message"><span data-upload-error></span></div>
</div>
