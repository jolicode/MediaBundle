{% import ['@SyliusBootstrapAdminUi/shared/helper/header.html.twig', '@SyliusAdmin/shared/helper/header.html.twig'] as header %}

{% set media = hookable_metadata.context.media %}

<div class="col-12 col-md-6" data-component="media-rename">
    <div class="d-md-flex gap-2 align-items-center">
        <span data-component="media-name">{{ header.h1(media.fileName) }}</span>
        <form data-component="media-rename-form" name="media-rename-form" action="{{ path('joli_media_sylius_admin_rename') }}" method="POST" hidden>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('media_rename') }}">
            <input type="hidden" name="oldPath" value="{{ media.path }}">
            <input type="hidden" name="newPath" value="">
            <div class="input-group">
                <input type="text" class="form-control" data-component="media-rename-input" value="{{ media.fileName }}">
                <button type="submit" class="btn btn-primary">
                    {{ ux_icon('tabler:check') }}
                </button>
                <button type="button" class="btn btn-secondary" data-component="media-rename-cancel">
                    {{ ux_icon('tabler:x') }}
                </button>
            </div>
        </form>
    </div>
</div>
