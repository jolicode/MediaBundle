{% set media = data %}
{% set criteria = app.request.query.all('criteria') %}
{% set is_recursive = criteria['search']['value']|default('') != ''  %}

<span data-component="media-name">{{ is_recursive ? media.path : media.filename}}</span>
<form action="{{ path('joli_media_sylius_admin_rename') }}" data-component="media-rename-form" method="POST" hidden>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('media_rename') }}">
    <input type="hidden" name="oldPath" value="{{ media.path }}">
    <input type="hidden" name="newPath" value="">
    <div class="input-group input-group-sm">
        <input type="text" class="form-control" data-component="media-rename-input" value="{{ media.filename }}">
        <button type="submit" class="btn btn-primary">
            {{ ux_icon('tabler:check') }}
        </button>
        <button type="button" class="btn btn-secondary" data-component="media-rename-cancel">
            {{ ux_icon('tabler:x') }}
        </button>
    </div>
</form>
