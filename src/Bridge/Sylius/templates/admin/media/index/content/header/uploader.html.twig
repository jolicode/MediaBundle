{% set config = hookable_metadata.context.config %}
{% set create_media_form = hookable_metadata.context.create_media_form %}

<div class="row">
    <div class="uploader-container" data-component="uploader-container">
        {{ form_start(create_media_form, { attr: {
            class: 'uploader',
            'data-component': 'uploader',
            'data-uploader-config': config.uploadOptions|json_encode(constant('JSON_THROW_ON_ERROR')),
        } }) }}
        {{ form_widget(create_media_form.path) }}
        {{ form_widget(create_media_form.file, { attr: { class: 'uploader-hidden-input' } }) }}
        {{ form_widget(create_media_form._token) }}
        <div class="uploader-preview-template" data-component="uploader-preview-template">
            {{ include('@JoliMediaSylius/uploaded_file_preview.html.twig') }}
        </div>
        {{ form_end(create_media_form) }}
    </div>
</div>
