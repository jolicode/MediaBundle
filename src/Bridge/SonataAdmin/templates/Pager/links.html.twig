{# Adapted from SonataAdmin/Pager/base_links.html.twig #}
{% set pager_route_params = { key: pager.currentKey } %}
{% if pager.searchValue %}
    {% set pager_route_params = pager_route_params|merge({ query: pager.searchValue }) %}
{% endif %}
<div class="text-center">
    <ul class="pagination">
        {% if pager.page > 2 %}
            <li><a href="{{ path(pager.routeName, pager_route_params|merge({ page: 1 })) }}" title="{{ 'link_first_pager'|trans({ }, 'SonataAdminBundle') }}">&laquo;</a></li>
        {% endif %}

        {% if pager.page != pager.previousPage %}
            <li><a href="{{ path(pager.routeName, pager_route_params|merge({ page: pager.previousPage })) }}" title="{{ 'link_previous_pager'|trans({ }, 'SonataAdminBundle') }}">&lsaquo;</a></li>
        {% endif %}

        {% for page in pager.getLinks(7) %}
            {% if page == pager.page %}
                <li class="active"><a href="{{ path(pager.routeName, pager_route_params|merge({ page: page })) }}">{{ page }}</a></li>
            {% else %}
                <li><a href="{{ path(pager.routeName, pager_route_params|merge({ page: page })) }}">{{ page }}</a></li>
            {% endif %}
        {% endfor %}

        {% if pager.page != pager.nextPage %}
            <li><a href="{{ path(pager.routeName, pager_route_params|merge({ page: pager.nextPage })) }}" title="{{ 'link_next_pager'|trans({ }, 'SonataAdminBundle') }}">&rsaquo;</a></li>
        {% endif %}

        {% if pager.page != pager.lastPage and pager.lastPage != pager.nextPage %}
            <li><a href="{{ path(pager.routeName, pager_route_params|merge({ page: pager.lastPage })) }}" title="{{ 'link_last_pager'|trans({ }, 'SonataAdminBundle') }}">&raquo;</a></li>
        {% endif %}
    </ul>
</div>
