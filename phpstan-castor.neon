parameters:
    tmpDir: tools/phpstan/var/castor
    level: 8
    paths:
        - castor.php
        - .castor/
    excludePaths:
        - .castor/vendor
    scanFiles:
        - .castor.stub.php
    # castor-php/docker, used by .castor/demo.php
    bootstrapFiles:
        - .castor/vendor/autoload.php
